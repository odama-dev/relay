# ---------------------------------------------------------------------------
# Database — Prisma owns the schema (prisma/migrations, incl. RLS policies).
# ---------------------------------------------------------------------------
# Local Supabase (`pnpm db:up` → supabase start):
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"
# A throwaway database the RLS test suite may wipe (`pnpm test:rls`).
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/odama_test?schema=public"
# Self-hosted Supabase on the VPS: point both at its Postgres (direct, not
# the transaction pooler — withRls() uses interactive transactions).

# ---------------------------------------------------------------------------
# Supabase Auth + Storage (`supabase status` prints the local keys)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
# Server only — never expose. Used for invites, password resets, storage.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# On the VPS: where headless Chrome reaches the app to print invoice PDFs.
# INTERNAL_APP_URL="http://127.0.0.1:3000"
# CHROME_PATH="/usr/bin/chromium"
# Comma-separated emails that become active C-Level admins on first sign-in.
ADMIN_EMAILS="hellorafi@odama.io"
# Without the Supabase vars, local dev signs you in as DEV_AUTH_EMAIL
# (default: the first ADMIN_EMAILS entry). Switch people to test roles.
# DEV_AUTH_BYPASS=true
# DEV_AUTH_EMAIL="ana@odama.io"

# ---------------------------------------------------------------------------
# Email — Resend (invites, password resets, invoices to clients)
# ---------------------------------------------------------------------------
# Without a key outside production, emails are printed to the server log.
RESEND_API_KEY=""
MAIL_FROM="Odama OS <no-reply@odama.io>"

# ---------------------------------------------------------------------------
# Slack — bot DMs (scopes: users:read, users:read.email, chat:write, im:write)
# ---------------------------------------------------------------------------
SLACK_BOT_TOKEN=""

# ---------------------------------------------------------------------------
# Xendit — payment links + webhook
# ---------------------------------------------------------------------------
# Without a key outside production, links open the local simulator /dev/pay/<id>.
XENDIT_SECRET_KEY=""
# Must match "Callback verification token" in the Xendit dashboard.
XENDIT_CALLBACK_TOKEN="change-me"

# ---------------------------------------------------------------------------
# Scheduled jobs — the VPS cron sends `Authorization: Bearer $CRON_SECRET`
# ---------------------------------------------------------------------------
CRON_SECRET="change-me"

# Seed password for local Supabase users (pnpm db:seed).
# SEED_PASSWORD="odama-dev-123"

