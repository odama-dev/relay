# ---------------------------------------------------------------------------
# Database — Prisma owns the schema (prisma/migrations, incl. RLS policies).
# ---------------------------------------------------------------------------
# Local Supabase (`pnpm db:up` → supabase start):
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"
# A throwaway database the RLS test suite WIPES (`pnpm test:rls` drops the
# public and app schemas). Local Supabase, or a separate staging Supabase
# project — never the production project.
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/odama_test?schema=public"
#
# Production = Supabase Cloud + Vercel (docs/SUPABASE_SETUP.md §3). Put these
# in .env.cloud for `pnpm cloud:*` and in the Vercel project env. Dashboard → Connect → ORMs → Prisma. Both go through
# the Supavisor pooler (IPv4; the direct db.<ref> host is IPv6-only).
# Runtime = transaction mode (6543): withRls() is one transaction with
# transaction-local settings, so it is safe; pgbouncer=true turns off
# prepared statements. connection_limit is Prisma's pool PER PROCESS: keep it
# >= 10 — a page fans out parallel queries and runs system reads next to an
# open withRls() transaction, so 1 deadlocks the pool ("Timed out fetching a
# new connection"). Supavisor multiplexes these onto the real Postgres pool.
# Migrations = session mode (5432).
# DATABASE_URL="postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
# DIRECT_URL="postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY: Settings → API Keys → Legacy (JWT)
# Required by `pnpm cloud:seed` (with-env.mjs refuses the default / <12 chars):
# SEED_PASSWORD="<strong password>"
# ADMIN_EMAILS="hellorafi@odama.io"
#
# Self-hosted Supabase on a VPS (legacy, docs/VPS_DEPLOY.md): point both URLs at
# its Postgres directly.

# ---------------------------------------------------------------------------
# Supabase Auth + Storage (`supabase status` prints the local keys)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
# Server only — never expose. Used for invites, password resets, storage.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# On the VPS: where headless Chrome reaches the app to print invoice PDFs.
# INTERNAL_APP_URL="http://127.0.0.1:3000"
# CHROME_PATH="/usr/bin/chromium"
# Comma-separated emails that become active C-Level admins on first sign-in.
ADMIN_EMAILS="hellorafi@odama.io"
# Without the Supabase vars, local dev signs you in as DEV_AUTH_EMAIL
# (default: the first ADMIN_EMAILS entry). Switch people to test roles.
# DEV_AUTH_BYPASS=true
# DEV_AUTH_EMAIL="ana@odama.io"

# ---------------------------------------------------------------------------
# Email — Resend (invites, password resets, invoices to clients)
# ---------------------------------------------------------------------------
# Without a key outside production, emails are printed to the server log.
RESEND_API_KEY=""
MAIL_FROM="Odama OS <hellodama@odama.io>"   # a verified Resend domain; account emails (invites, resets)

# ---------------------------------------------------------------------------
# Slack — bot DMs (scopes: users:read, users:read.email, chat:write, im:write)
# ---------------------------------------------------------------------------
SLACK_BOT_TOKEN=""

# ---------------------------------------------------------------------------
# Xendit — payment links + webhook
# ---------------------------------------------------------------------------
# Without a key outside production, links open the local simulator /dev/pay/<id>.
XENDIT_SECRET_KEY=""
# Must match "Callback verification token" in the Xendit dashboard.
XENDIT_CALLBACK_TOKEN="change-me"

# ---------------------------------------------------------------------------
# Scheduled jobs — the VPS cron sends `Authorization: Bearer $CRON_SECRET`
# ---------------------------------------------------------------------------
CRON_SECRET="change-me"

# Seed password for local Supabase users (pnpm db:seed).
# SEED_PASSWORD="odama-dev-123"

